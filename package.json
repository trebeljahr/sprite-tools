{
  "name": "@trebeljahr/sprite-tools",
  "version": "0.1.0",
  "description": "Toolkit for turning sprite sheets into game-ready assets — collision polygons, pivots, animation tags, pixel-art conversion, normal maps, palette swap, atlas packing, GIF export. Ships a CLI, an MCP server, and a web app off one algorithm core.",
  "keywords": [
    "sprite",
    "spritesheet",
    "pixel-art",
    "game-dev",
    "collision",
    "normal-map",
    "texture-atlas",
    "palette",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/trebeljahr/sprite-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/sprite-tools.git"
  },
  "bugs": {
    "url": "https://github.com/trebeljahr/sprite-tools/issues"
  },
  "author": "Rico Trebeljahr",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "sprite-tools": "./dist/cli/index.js",
    "sprite-tools-mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist/cli/**/*.{js,d.ts}",
    "dist/mcp/**/*.{js,d.ts}",
    "dist/src/lib/**/*.{js,d.ts}",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenvx run -f .env.development.local -f .env --ignore=MISSING_ENV_FILE -- next dev -p 3471",
    "build": "next build",
    "start": "next start -p 3471",
    "build:local": "dotenvx run -f .env.production -f .env --ignore=MISSING_ENV_FILE -- next build",
    "start:local": "dotenvx run -f .env.production -f .env --ignore=MISSING_ENV_FILE -- next start -p 3471",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cli:build": "tsc -p cli/tsconfig.json && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "cli:dev": "tsx cli/index.ts",
    "mcp:build": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p mcp/tsconfig.json && node -e \"require('fs').chmodSync('dist/mcp/index.js', 0o755)\"",
    "mcp:dev": "tsx mcp/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "install-local": "pnpm run cli:build && pnpm run mcp:build && npm install -g .",
    "release": "pnpm run release:patch",
    "release:patch": "node scripts/release-prep.mjs && node scripts/release-bump.mjs patch && pnpm run _release:finish",
    "release:minor": "node scripts/release-prep.mjs && node scripts/release-bump.mjs minor && pnpm run _release:finish",
    "release:major": "node scripts/release-prep.mjs && node scripts/release-bump.mjs major && pnpm run _release:finish",
    "_release:finish": "pnpm run cli:build && pnpm run mcp:build && pnpm run typecheck && npm publish && git push --follow-tags",
    "prepublishOnly": "pnpm run cli:build && pnpm run mcp:build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,md,mdx}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@biomejs/biome": "^2.4.13",
    "@dotenvx/dotenvx": "^1.62.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.4",
    "@openpanel/web": "^1.3.0",
    "@sentry/browser": "^10.50.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "9.1.7",
    "jszip": "^3.10.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "16.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
