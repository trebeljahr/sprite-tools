# Server-only configuration. Never commit real values.
# Use either POSTGRES_URL (Hatchkit's managed Postgres) or PGHOST/PGDATABASE/
# PGUSER/PGPASSWORD (docker-compose.accounts.yml sets these).
POSTGRES_URL=
BETTER_AUTH_URL=https://sprites.trebeljahr.com
BETTER_AUTH_SECRET=
# Hatchkit project-scoped Listmonk transactional email. No auth-link logging.
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_TX_TEMPLATE_ID=
LISTMONK_FROM_EMAIL=
# Only needed for the optional compose-managed database.
ACCOUNTS_DB_PASSWORD=
