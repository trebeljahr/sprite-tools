# Server-only configuration. Never commit real values.
# Use either POSTGRES_URL (Hatchkit's managed Postgres) or PGHOST/PGDATABASE/
# PGUSER/PGPASSWORD (docker-compose.accounts.yml sets these).
POSTGRES_URL=
BETTER_AUTH_URL=https://sprites.trebeljahr.com
BETTER_AUTH_SECRET=
# Hatchkit project-scoped Listmonk transactional email. No auth-link logging.
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_TX_TEMPLATE_ID=
LISTMONK_FROM_EMAIL=
# Only needed for the optional compose-managed database.
ACCOUNTS_DB_PASSWORD=

# Preferred: Hatchkit isolated direct SES transport. Shared AWS credential
# chains and relay credentials are never used as a fallback.
EMAIL_TRANSPORT=ses
SES_PROJECT_ACCESS_KEY_ID=
SES_PROJECT_SECRET_ACCESS_KEY=
SES_PROJECT_REGION=
SES_PROJECT_IDENTITY_ARN=
SES_PROJECT_TENANT=
SES_PROJECT_CONFIGURATION_SET=
SES_PROJECT_FROM_EMAIL=
# Required for non-production delivery; tests never send.
EMAIL_TEST_RECIPIENT=

# Explicitly run additive migrations before the server accepts traffic.
ACCOUNTS_MIGRATE_ON_START=false
