# Env story: dotenvx is the single source of truth.
#
#   * Local dev:        encrypt your values into `.env.development`,
#                       keep the matching DOTENV_PRIVATE_KEY in
#                       Keychain / 1Password (see README "Local
#                       secrets").
#   * Local prod test:  same with `.env.production`, run `build:local`.
#   * CI / Vercel:      env vars come from the platform; dotenvx is
#                       not in the path (see `build` / `start` scripts).
#
# .env.production is gitignored by default as defense-in-depth. Once
# encrypted with `dotenvx encrypt -f .env.production` you can opt it
# back in with `git add -f .env.production` so teammates can pull it.
# The matching `.env.keys` stays local always.
#
# Do NOT keep a `.env.local` — Next.js reads it directly and would
# shadow the dotenvx-loaded values, leading to "why is this old key
# still showing up" surprises.
#
# All `NEXT_PUBLIC_*` vars are inlined into the browser bundle at
# build time — treat them as public. Real secrets (like XAI_API_KEY)
# never get the prefix and stay server-side.

# -- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sprite-tools.example.com

# -- Feature flags ----------------------------------------------------
# Flip to "true" to expose the AI tools (currently hidden behind auth).
NEXT_PUBLIC_ENABLE_AI=false

# -- Analytics (OpenPanel) --------------------------------------------
# Leave blank to disable tracking entirely.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_API_URL=https://api.openpanel.dev
# Set to "true" to also track in `npm run dev` (off by default so local
# development doesn't pollute prod analytics).
NEXT_PUBLIC_OPENPANEL_ENABLE_IN_DEV=false

# -- Error monitoring (GlitchTip, Sentry-compatible) ------------------
# Leave blank to disable error reporting entirely.
NEXT_PUBLIC_GLITCHTIP_DSN=

# -- Secrets (server-side only, never inlined) ------------------------
# xAI API key powers the AI sprite/animation tools when AI is enabled.
XAI_API_KEY=
