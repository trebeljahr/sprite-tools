# Copy to `.env.local` for local dev, or encrypt with dotenvx into
# `.env.production` / `.env.development` before committing.
#
# All `NEXT_PUBLIC_*` vars are inlined into the browser bundle at build
# time — treat them as public. Runtime-only secrets (like XAI_API_KEY)
# stay server-side and are what dotenvx is actually encrypting.

# -- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sprite-tools.example.com

# -- Feature flags ----------------------------------------------------
# Flip to "true" to expose the AI tools (currently hidden behind auth).
NEXT_PUBLIC_ENABLE_AI=false

# -- Analytics (OpenPanel) --------------------------------------------
# Leave blank to disable tracking entirely.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_API_URL=https://api.openpanel.dev
# Set to "true" to also track in `npm run dev` (off by default so local
# development doesn't pollute prod analytics).
NEXT_PUBLIC_OPENPANEL_ENABLE_IN_DEV=false

# -- Error monitoring (GlitchTip, Sentry-compatible) ------------------
# Leave blank to disable error reporting entirely.
NEXT_PUBLIC_GLITCHTIP_DSN=

# -- Secrets (server-side only, never inlined) ------------------------
# xAI API key powers the AI sprite/animation tools when AI is enabled.
XAI_API_KEY=
