# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — we use dotenvx, so encrypted .env.production /
# .env.development can safely be committed. Local overrides and the
# decryption keys stay out of git.
.env
.env.local
.env.*.local
.env.keys
.env.vault
.next

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local state
.claude/
# claude code
.claude/settings.local.json
.claude/worktrees/
